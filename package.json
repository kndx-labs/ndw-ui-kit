{
  "name": "ndw-ui-kit",
  "version": "0.0.1",
  "scripts": {
    "clean": "rimraf dist",
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve",
    "playground:ngx-translate": "ng serve playground --configuration ngx-translate",
    "playground:no-l10n": "ng serve playground --configuration no-l10n",
    "build": "yarn run prepare-icons && yarn run prepare-pictograms && ng build --project ndw-ui-kit && tsx scripts/strip-dist-scss-comments.ts",
    "build-playground": "yarn run build && npx ng build playground",
    "watch": "ng build --project ndw-ui-kit --watch --configuration development",
    "test": "ng test playground",
    "test:conformance": "ng run playground:test-conformance",
    "check:spec-coverage": "tsx src/tests/tools/check-spec-coverage.ts",
    "generate:button-rules": "tsx src/tests/tools/generate-rule-spec.ts",
    "fmt": "dprint fmt \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:ts-src": "eslint --cache --cache-location .eslintcache-src \"src/**/*.ts\" \"src/**/*.component.html\"",
    "lint:ts-scripts": "eslint --cache --cache-location .eslintcache-scripts \"scripts/**/*.ts\"",
    "lint:ts": "run-p -c \"lint:ts-src {@}\" \"lint:ts-scripts {@}\" --",
    "lint:styles": "stylelint 'src/**/*.scss'",
    "lint-lib": "yarn run lint:ts-src && yarn run lint:styles",
    "lint-all": "yarn run lint:ts && yarn run lint:styles",
    "lint-all-fix": "yarn run lint:styles --fix && yarn run fmt && yarn run lint:ts --fix",
    "convert-figma-tokens": "tsx scripts/convert-figma-tokens.ts",
    "sync-figma-icons": "tsx scripts/figma/sync-icons.ts",
    "prepare-icons": "tsx scripts/preprocess-icon-svgs.ts \"$@\" && tsx scripts/collect-base-icon-usage.ts && tsx scripts/generate-icon-names.ts && tsx scripts/generate-sprite.ts",
    "prepare-pictograms": "tsx scripts/preprocess-pictogram-svgs.ts \"$@\" && tsx scripts/generate-pictogram-names.ts && tsx scripts/generate-pictogram-sprite.ts",
    "check-base-icons": "tsx scripts/collect-base-icon-usage.ts --check",
    "build-custom-sprite": "tsx scripts/build-custom-sprite.ts",
    "emit-custom-sprite-cli": "tsx scripts/emit-custom-sprite-cli.ts",
    "copy-custom-sprite-sources": "tsx scripts/copy-custom-sprite-sources.ts",
    "verify:publish-artifacts": "tsx scripts/verify-publish-artifacts.ts",
    "build:to-publish": "yarn run build && yarn run emit-custom-sprite-cli && yarn run copy-custom-sprite-sources && yarn run verify:publish-artifacts",
    "publish:lib": "tsx scripts/publish.ts"
  },
  "private": true,
  "peerDependencies": {
    "@angular/cdk": "20.x",
    "@angular/common": "20.x",
    "@angular/core": "20.x",
    "@angular/forms": "20.x",
    "@ngx-translate/core": "18.x"
  },
  "peerDependenciesMeta": {
    "@ngx-translate/core": {
      "optional": true
    }
  },
  "sideEffects": false,
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.35",
    "@angular/cdk": "20.2.14",
    "@angular/cli": "20.3.35",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/compiler-cli": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/router": "20.3.30",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "9.39.5",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/d3": "7.4.3",
    "@types/fs-extra": "11.0.4",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@types/svg-sprite": "0.0.39",
    "@types/xml2js": "0.4.14",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/types": "8.67.0",
    "@vitest/browser": "^3.2.7",
    "angular-eslint": "20.7.0",
    "chalk": "6.0.0",
    "dotenv": "17.4.2",
    "dprint": "0.55.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.0",
    "globals": "17.11.0",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "marked": "18.0.10",
    "ng-packagr": "20.3.2",
    "node-jq": "6.3.1",
    "node-ssh": "13.2.1",
    "npm-run-all2": "9.0.3",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "pretty-json-stringify": "0.0.2",
    "rimraf": "6.1.3",
    "rxjs": "~7.8.2",
    "stylelint": "17.14.1",
    "stylelint-config-hudochenkov": "13.0.2",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-no-unsupported-browser-features": "8.1.1",
    "stylelint-order": "8.1.1",
    "stylelint-scss": "7.2.0",
    "svg-sprite": "2.0.4",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7",
    "xml2js": "0.6.2",
    "yargs": "18.1.0",
    "zone.js": "~0.15.1"
  },
  "packageManager": "yarn@4.4.1"
}
