{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "outDir": "../out-tsc/storybook",
    "types": [],
    "paths": {
      "@ndw-ui-kit/core": ["./src/lib/public-api.ts"],
      "@ndw-ui-kit/core/utils": ["./src/lib/utils/index.ts"],
      "@ndw-ui-kit/core/aria": ["./src/lib/aria/index.ts"],
      "@ndw-ui-kit/core/l10n": ["./src/lib/l10n/index.ts"],
      "@ndw-ui-kit/core/l10n/ngx-translate": ["./src/lib/l10n/ngx-translate/index.ts"],
      "@ndw-ui-kit/core/popover": ["./src/lib/popover/index.ts"],
      "@ndw-ui-kit/core/form-field": ["./src/lib/form-field/index.ts"],
      "@ndw-ui-kit/core/table": ["./src/lib/table/index.ts"],
      "@ndw-ui-kit/core/schedule-actions": ["./src/lib/schedule-actions/index.ts"],
      "@ndw-ui-kit/core/widgets": ["./src/lib/widgets/index.ts"],
      "@sb/*": ["./.storybook/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../src/lib/**/*.stories.ts",
    "../src/storybook/**/*.ts"
  ]
}
