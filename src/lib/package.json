{
  "name": "@ndw-ui-kit/core",
  "description": "UI components library for Angular",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kndx-labs/ndw-ui-kit.git"
  },
  "homepage": "https://github.com/kndx-labs/ndw-ui-kit",
  "bin": {
    "ndw-ui-kit-build-sprite": "./tools/build-custom-sprite.mjs"
  },
  "peerDependencies": {
    "@angular/cdk": "20.x",
    "@angular/common": "20.x",
    "@angular/core": "20.x",
    "@angular/forms": "20.x",
    "@ngx-translate/core": "18.x",
    "rxjs": "^7.4.0"
  },
  "peerDependenciesMeta": {
    "@ngx-translate/core": {
      "optional": true
    }
  },
  "sideEffects": false,
  "exports": {
    "./styles/*.scss": {
      "sass": "./styles/*.scss",
      "style": "./styles/*.scss"
    },
    "./styles/*": {
      "sass": "./styles/*.scss",
      "style": "./styles/*.scss"
    },
    "./assets/*": "./assets/*"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "svg-sprite": "^2.0.4"
  }
}
